{
  "expo": {
    "name": "offnote",
    "slug": "offnote",
    "version": "1.0.4",
    "orientation": "portrait",
    "icon": "./assets/icon-ios.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FDF7F3",
        "foregroundImage": "./assets/icon-android.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "REQUEST_INSTALL_PACKAGES",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO"
      ],
      "predictiveBackGestureEnabled": false,
      "package": "com.digidaga.offnote"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-media-library",
        {
          "photosPermission": "OffNote 需要访问相册以保存你下载的视频和图片",
          "savePhotosPermission": "OffNote 需要保存下载的视频和图片到你的相册",
          "isAccessMediaLocationEnabled": false
        }
      ],
      "expo-font",
      "expo-sharing",
      [
        "expo-splash-screen",
        {
          "image": "./assets/start.png",
          "imageWidth": 414,
          "resizeMode": "cover",
          "backgroundColor": "#FDF7F3",
          "enableFullScreenImage_legacy": true,
          "ios": {
            "enableFullScreenImage_legacy": true,
            "image": "./assets/start.png",
            "imageWidth": 414,
            "resizeMode": "cover",
            "backgroundColor": "#FDF7F3"
          },
          "android": {
            "image": "./assets/start.png",
            "imageWidth": 288,
            "resizeMode": "cover",
            "backgroundColor": "#FDF7F3"
          }
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "e2a1f8d0-8944-4737-bfd1-febb5b6cb0d1"
      }
    },
    "owner": "digidaga"
  }
}
